NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never NEXT_PUBLIC): evaluator persistence + admin flows
SUPABASE_SERVICE_ROLE_KEY=

# LLM + voice providers. GROQ_API_KEY serves chat LLMs (default provider),
# Whisper STT, and Orpheus TTS. ANTHROPIC_API_KEY is only needed when rolling
# back with LLM_PROVIDER=anthropic (per-role overrides: see src/lib/llm/config.ts).
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=fake     # offline deterministic adapter: no key, no network, no
#                       # cost. Local plumbing + E2E only — never a scoring,
#                       # calibration, or certification run.
# ELEVENLABS_API_KEY=   # optional TTS A/B only

# Per-user daily persona-turn budget (SEC-3). Unset = 150.
# PERSONA_DAILY_TURN_BUDGET=150

# Playwright E2E (app/e2e). The spec is SKIPPED unless all four are set; it
# signs in as a seeded trainee and writes real rows, so point it at a
# throwaway/local Supabase project, never production.
# E2E_SUPABASE_URL=
# E2E_SUPABASE_ANON_KEY=
# E2E_TRAINEE_EMAIL=
# E2E_TRAINEE_PASSWORD=
# E2E_BASE_URL=http://localhost:3000   # optional; defaults to a dev server Playwright starts
